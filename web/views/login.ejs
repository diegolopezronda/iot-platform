<style>
html{
	background:#ecf0f5;
	overflow-x:hidden;
}
.sensum-login-well-mobile{
	position:relative;
	left: 0;
	top: 0;
	transform:none;
}
</style>
<!--RESPONSE MODALS-->
<div id="sensum-login-access-modal" class="modal modal-default fade" role="dialog">
	<div class="modal-dialog modal-sm">
		<div class="modal-content">
			<div class="modal-body text-center">
				<p>
					<i class="fa fa-4x fa-lock"></i>
				</p>
					{{ 'DASHBOARD_WRONG_DOMAIN_ERROR' | translate}}
				</p>
				<p class="callout callout-success" ng-show="success">
					{{success | translate}}
				</p>
			</div>
			<div ng-show="success" class="modal-footer">
				<button type="button" class="btn btn-default btn-block" data-dismiss="modal">
					Close
				</button>
			</div>
			<div ng-show="!success" class="modal-footer">
    		<button
					type="button" 
					class="btn bg-blue btn-block"
					ng-show="sensum.project.is_public_project === true"
					ng-click="joinProject()"
				>
					{{'DASHBOARD_JOIN_BUTTON' | translate}}
				</button>
    		<button
					type="button" 
					class="btn bg-purple btn-block" 
					ng-show="sensum.project.is_public_project === false"
					ng-click="requestProjectAccess()"
				>
					{{'DASHBOARD_REQUEST_ACCESS_BUTTON' | translate}}
				</button>
				<button type="button" class="btn btn-default btn-block" data-dismiss="modal">
					Cancel
				</button>
			</div>
		</div>
	</div>
</div>
