<div class="wrapper" ng-show="angular_progress && !session_timeout">
  <!-- Main Header -->
  <header class="main-header" ng-show="!params.is_frame">

    <!-- Logo -->
    <a 
			href="{{HOMEPAGE}}" 
			class="logo" 
			style="background:white!important"
		>
			<img 
				ng-show="user.is_system_user === false"
				ng-src="/img/database/project/{{sensum.project.id_project}}.png?{{key}}" 
				alt="logo" 
				style="height:30px!important"
			/>
			<!-- logo for regular state and mobile devices -->
			<span 
				class="text-black"
				ng-show="user.is_system_user === true"
			>
				<b>Sensum</b>Admin
			</span>
		</a>

    <!-- Header Navbar -->
    <nav class="navbar navbar-static-top" role="navigation">
      <!-- Sidebar toggle button-->
      <a href="#" class="sidebar-toggle" data-toggle="offcanvas" role="button">
        <span class="sr-only">Toggle navigation</span>
      </a>
      <!-- Navbar Right Menu -->
      <div class="navbar-custom-menu">
        <ul class="nav navbar-nav">
					<li class="dropdown messages-menu hidden">
            <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-expanded="true">
              <i class="fa fa-envelope-o"></i>
              <span class="label label-success">
								{{device_messages.length}}
							</span>
            </a>
            <ul class="dropdown-menu">
              <li class="header">You have {{device_messages.length}} messages</li>
              <li>
                <!-- inner menu: contains the actual data -->
                <div class="slimScrollDiv" style="position: relative; overflow: hidden; width: auto; height: 200px;"><ul class="menu" style="overflow: hidden; width: 100%; height: 200px;">
                  <li ng-repeat="m in device_messages"><!-- start message -->
                    <a href="#">
                      <div class="pull-left">
                        <img
													src="/img/database/user/{{m.id_user}}.jpg" class="img-circle" alt="User Image">
                      </div>
                      <h4>
                        {{first_name_user}}
                        <small>
													<i class="fa fa-clock-o"></i>
													{{m.date | date:'HH:mm'}}
												</small>
                      </h4>
                      <p>
												{{m.message}}
											</p>
                    </a>
                  </li>
                  <!-- end message -->
                </ul><div class="slimScrollBar" style="background: rgb(0, 0, 0); width: 3px; position: absolute; top: 0px; opacity: 0.4; display: block; border-radius: 7px; z-index: 99; right: 1px;"></div><div class="slimScrollRail" style="width: 3px; height: 100%; position: absolute; top: 0px; display: none; border-radius: 7px; background: rgb(51, 51, 51); opacity: 0.2; z-index: 90; right: 1px;"></div></div>
              </li>
              <li class="footer hidden"><a href="#">See All Messages</a></li>
            </ul>
          </li>
					<li>
            <a 
							href="#" 
							class="dropdown-toggle" 
							ng-show="show_help === true"
							ng-click="showHelp(false)" 
						>
              <i class="fa fa-fw fa-question-circle-o"></i>
							<span class="hidden-sm hidden-xs">
								{{'DASHBOARD_HIDE_HELP_BUTTON' | translate}}
							</span>
            </a>
            <a 
							href="#" 
							class="dropdown-toggle" 
							ng-show="show_help === false"
							ng-click="showHelp(true)" 
						>
              <i class="fa fa-fw fa-question-circle"></i>
							<span class="hidden-sm hidden-xs">
								{{'DASHBOARD_SHOW_HELP_BUTTON' | translate}}
							</span>
            </a>
					</li>
					<li>
            <a 
							href="#" 
							class="dropdown-toggle" 
							data-target="#sensum-feedback-modal"
							data-toggle="modal"
						>
              <i class="fa fa-fw fa-bullhorn"></i>
							<span class="hidden-sm hidden-xs">
								{{'DASHBOARD_FEEDBACK_BUTTON' | translate}}
							</span>
            </a>
          </li>					
          <!-- User Account Menu -->
          <li class="dropdown user user-menu">
            <!-- Menu Toggle Button -->
            <a 
							href="#" 
							class="dropdown-toggle" 
							data-toggle="dropdown"
						>
              <!-- The user image in the navbar-->
							<img ng-src="/img/database/user/{{user.id_user}}.jpg?{{key}}" class="user-image" alt="User Image">
              <!-- hidden-xs hides the username on small devices so only the image appears. -->
              <span class="hidden-xs">{{user.first_name_user}}</span>
            </a>
            <ul class="dropdown-menu">
              <!-- The user image in the menu -->
              <li class="user-header">
                <img ng-src="/img/database/user/{{user.id_user}}.jpg?{{key}}" class="img-circle" alt="User Image">
                <p>
									{{user.first_name_user}}&nbsp;
									{{user.last_name_user}}
                </p>
              </li>
              <!-- Menu Footer-->
              <li class="user-footer">
                <div class="pull-left">
                  <a href="https://id.sensum.co.nz" class="btn btn-default btn-flat" target="_blank">
										<i class="fa fa-asterisk text-blue fa-fw"></i>{{'DASHBOARD_PROFILE_BUTTON' | translate}}
									</a>
                </div>
                <div class="pull-right">
                  <a href="#" ng-click="logout()" class="btn btn-default btn-flat">
										{{'DASHBOARD_SIGN_OUT_BUTTON' | translate}}
									</a>
                </div>
              </li>
            </ul>
          </li>
          <!-- Control Sidebar Toggle Button -->
          <li ng-show="visible.control_sidebar_toggle_button">
            <a href="#" data-toggle="control-sidebar"><i class="fa fa-gears"></i></a>
          </li>
        </ul>
      </div>
    </nav>
  </header>
  <!-- Left side column. contains the logo and sidebar -->
  <aside class="main-sidebar" ng-show='!params.is_frame'>

    <!-- sidebar: style can be found in sidebar.less -->
    <section class="sidebar">

      <!-- Sidebar user panel (optional) -->
      <div class="user-panel">
        <div class="pull-left image">
					<img ng-src="/img/database/user/{{user.id_user}}.jpg?{{key}}" class="img-circle" alt="User Image">
        </div>
        <div class="pull-left info">
          <p>{{user.first_name_user}}&nbsp;{{user.last_name_user}}</p>
          <!-- Status -->
          <a href="#">
						<i class="fa fa-mobile text-success" ng-show="is_mobile"></i>
						<i class="fa fa-laptop text-success" ng-show="!is_mobile"></i>
						{{'DASHBOARD_ONLINE' | translate}}
					</a>
        </div>
      </div>

      <!-- search form (Optional) -->
      <form action="#" method="get" class="sidebar-form hidden">
        <div class="input-group">
          <input type="text" name="q" class="form-control" placeholder="Filter links...." ng-model="link_filter">
              <span class="input-group-btn">
                <span type="button" name="search" id="search-btn" class="btn btn-flat"><i class="fa fa-search"></i>
                </span>
              </span>
        </div>
      </form>
      <!-- /.search form -->

      <!-- Sidebar Menu -->
      <ul class="sidebar-menu">
        <li class="header text-uppercase">
					Sensum Platform
				</li>
        <li class="header text-uppercase hidden">
					{{'DASHBOARD_NAVIGATION' | translate}}
				</li>
        <!-- Optionally, you can add icons to the links -->
				<li>
					<a href="{{HOMEPAGE}}">
						<i class="fa fa-fw fa-dashboard"></i>&nbsp;
						{{'DASHBOARD_DASHBOARD' | translate}}
					</a>
				</li>
				<li 
					ng-show="sensum.links[level.name_level.toLowerCase()]" 
					ng-repeat="level in sensum.capabilities"
					class="treeview  {{$index === 0 ? 'active' : '' }}"
				>
					<a href="#" class="text-capitalize">
						<i class="fa fa-fw fa-{{level.schema_level.icon}}"></i>&nbsp;
						<span>{{level.schema_level.menu[sensum.language]}}</span>
						<span class="pull-right-container">
              <i class="fa fa-angle-left pull-right"></i>
            </span>
					</a>
					<ul class="treeview-menu">
						<li ng-repeat="link in sensum.links[level.name_level.toLowerCase()]">
							<a ng-href="{{HOMEPAGE}}/{{link.url_link}}">
								<i class="fa fa-fw fa-{{link.icon_link}}"></i>&nbsp;
								{{link.name_link[sensum.language]}}
								<span class="pull-right-container">
								  <small 
										ng-repeat="label in link.labels"
										class="label pull-right bg-{{label.color}}"
									>
										{{label.name}}
									</small>
								</span>
							</a>
						</li>
					</ul>
				</li>
      </ul>
      <!-- /.sidebar-menu -->
    </section>
    <!-- /.sidebar -->
  </aside>

  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header" ng-show="!params.is_frame">
      <h1>
        <span class="text-capitalize">
					{{page_header}}
				</span>
				<i 
					class="fa fa-question-circle text-gray hidden"
					title="{{optional_description}}"
					data-toggle="tooltip"
				></i>
				<button
					type="button"
					class="btn btn-default"
					data-toggle="modal"
					data-target="#sensum-i18n-modal"
					ng-show="user.is_system_user === true"
				>
					<i 
						class="fa fa-language"
					></i>
				</button>
				&nbsp;
			<div class="pull-right btn-group">
				<a href="/dashboard/" class="btn btn-default btn-sm">
					<i class="fa fa-dashboard fa-fw"></i>
					<span class="hidden-xs">Dashboard</span>
				</a>
				<button 
					type="button"
					class="btn bg-maroon btn-sm" 
					ng-show="user.domains.length > 1"
					data-toggle="modal"
					data-target="#sensum-context-modal"
				>
					<i class="fa fa-cube fa-fw"></i>
					<span class="hidden-xs">{{'DASHBOARD_CONTEXT_CHANGE' | translate}}</span>
				</button>
			</div>
      </h1>
      <ol class="breadcrumb hidden">
        <li><a href="{{homepage}}"><i class="fa fa-dashboard"></i>&nbsp;Dashboard</a></li>
        <li ng-repeat="crumb in breadcrumbs"><a href="{{crumb.href}}">{{crumb.label}}</a></li>
      </ol>
    </section>

    <!-- Main content -->
    <section class="content">
      <!-- Your Page Content Here -->
			<div class="alert alert-info" ng-show="supported_UA === false">
				<h4>
					<i class="fa fa-fw fa-info"></i>&nbsp;
					Browser Compatibility Warning
				</h4>
				<b>
					{{UA.browser_name}}&nbsp;
					<span ng-show="minimum_supported_UA">{{UA.browser_version}}</span>
				</b>&nbsp;
				is not supported by Sensum Platform.<br/>
				<span ng-show="!minimum_supported_UA">
					Please use a different web browser.
				</span>
				<span ng-show="minimum_supported_UA">
					Please update to version {{minimum_supported_UA}} o later.
				</span>
			</div>
			<div class="alert bg-purple" ng-show="privilege === false">
				<button type="button" class="close" ng-click="privilege = null">
					<i class="fa fa-fw fa-times"></i>
				</button>
				<h4>
					<i class="fa fa-fw fa-key"></i>&nbsp;
					{{ 'DASHBOARD_PRIVILEGE' | translate}}
				</h4>
				{{'DASHBOARD_PRIVILEGE_MESSAGE' | translate}}
			</div>
<!--ITEM-->
			<div class="row" ng-show="temp.item" id="sensum-item-bar">
				<div class="col-md-12">
					<div class="box bg-teal box-solid">
						<div class="box-header">
							<h3 class="box-title">
								<i class="fa fa-wifi fa-fw"></i>&nbsp;
								<b>{{temp.item.name_item}}</b>&nbsp;
								<span class="text-uppercase hidden-xs hidden-sm">
									(#{{temp.item.key_item}})
								</span>
							</h3>
							<div class="pull-right box-tools no-print">
								<div class="btn-group">
                  <a                                                               
                    ng-href="{{sanitize(menu.link,temp.item.id_item)}}"           
                    ng-repeat="menu in sensum.constants.SENSUM_DEVICE_MENUS"    
                    ng-show="(                                                  
                      !menu.condition ||                                        
                      d[menu.condition.key] === menu.condition.value            
                    )"                                                          
                    class="btn btn-sm btn-primary hidden-sm hidden-xs"                              
                  >
                    <i class="fa fa-{{menu.icon}}"></i>
                  </a>
									<a
										class="btn btn-sm bg-maroon"
										href="/dashboard/data/devices"
									>
										<i class="fa fa-list-alt"></i>
									</a>
									<a
										class="btn btn-sm bg-maroon"
										href="/dashboard/map"
									>
										<i class="fa fa-map"></i>
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<ng-view ng-show="privilege != false"></ng-view>
<!-- Modal -->
			<div id="sensum-feedback-modal" class="modal fade" role="dialog">
				<div class="modal-dialog">
					<div class="modal-content">
						<div class="modal-header">
        			<button type="button" class="close" data-dismiss="modal">
								<i class="fa fa-times"></i>
							</button>
        			<h4 class="modal-title">
								<i class="fa fa-bullhorn fa-fw"></i>{{ 'DASHBOARD_FEEDBACK_TITLE' | translate }}
							</h4>
						</div>
						<div class="modal-body" ng-switch="feedback.thank_you">
							<div class="form-group" ng-switch-when="false">
								<label>
									{{ 'DASHBOARD_FEEDBACK_LABEL' | translate }}
								</label>
								<textarea 
									style="width:100%;min-height:300px;"
									ng-model="feedback.insert.message_feedback"
									placeholder="{{ 'DASHBOARD_FEEDBACK_PLACEHOLDER' | translate }}"
									novalidate
								></textarea>
							</div>
							<div class="callout callout-info" ng-switch-when="true">
								<i class="fa fa-thumbs-up fa-fw"></i>Thank you!
							</div>
							<div ng-switch-default>
							</div>
						</div>
						<div class="modal-footer" ng-show="feedback.thank_you === false">
							<button 
								type="button" 
								class="btn btn-primary pull-right" 
								ng-click="sendFeedback()"
							>
								<i class="fa fa-paper-plane"></i>
							</button>
						</div>
					</div>
				</div>
			</div>
<div id="map-modal" class="modal fade" role="dialog" style="z-index:9000!important">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal">
					<i class="fa fa-times"></i>
				</button>
				<h4 class="modal-title">How to use Sensum in 3 steps</h4>
			</div>
			<div class="modal-body no-padding">
				<div 
					id="map-carousel" 
					class="carousel slide" 
					data-ride="carousel"
					data-interval="10000"
					data-pause="true"
				>
					<ol class="carousel-indicators">
						<li data-target="#map-carousel" data-slide-to="0" class="active text-red"></li>
						<li data-target="#map-carousel" data-slide-to="1" class="text-red"></li>
						<li data-target="#map-carousel" data-slide-to="2" class="text-red"></li>
					</ol>
					<!-- Wrapper for slides -->
					<div class="carousel-inner">
						<div class="item active">
							<img src="/img/carousel/bar.png" alt="Bar">
						</div>
						<div class="item">
							<img src="/img/carousel/zones.png" alt="Zone">
						</div>
						<div class="item">
							<img src="/img/carousel/devices.png" alt="Device">
						</div>
					</div>
					<!-- Left and right controls -->
					<a class="left carousel-control" href="#map-carousel" data-slide="prev">
						<span class="fa fa-chevron-left text-black"></span>
						<span class="sr-only">Previous</span>
					</a>
					<a class="right carousel-control" href="#map-carousel" data-slide="next">
						<span class="fa fa-chevron-right text-black"></span>
						<span class="sr-only">Next</span>
					</a>
				</div>
			</div>
			<div class="modal-footer">
				<button 
					type="button" 
					class="btn btn-default" 
					data-dismiss="modal"
					ng-click="acknowledge('howto_sensum1')"
				>
				Close
				</button>
			</div>
		</div>
	</div>
</div>
<!--RESPONSE MODALS-->
<div id="sensum-response-modal" class="modal modal-{{response_modal}} fade" role="dialog" style="z-index:9000!important">
	<div class="modal-dialog modal-sm">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal">
					<i class="fa fa-times"></i>
				</button>
				<h4 class="modal-title">
					<i class="fa fa-fw fa-{{response_icon}}"></i>&nbsp;
					{{ 'DASHBOARD_'+response_title | translate}}
				</h4>
			</div>
			<div class="modal-body text-center">
				<p>
					<i class="fa fa-4x fa-{{response_icon}}"></i>
				</p>
				<p>
					{{response_message | translate}}
				</p>
			</div>
			<div class="modal-footer">
				<button 
					type="button"
					class="btn btn-outline pull-right"
					data-dismiss="modal"
				>	
					<i class="fa fa-check fa-fw"></i>
					{{'DASHBOARD_OK' | translate}}
				</button>
			</div>
		</div>
	</div>
</div>
<!--domains-->
<div id="sensum-context-modal" class="modal fade" role="dialog" style="z-index:9000!important">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal">
					<i class="fa fa-times"></i>
				</button>
				<h4 class="modal-title">
					<i class="fa fa-cube fa-fw"></i>
					{{'DASHBOARD_CONTEXT_CHANGE' | translate}}
				</h4>
			</div>
			<div class="modal-body">
				<select
					class="form-control"
					ng-model="context"
					ng-options="k.url_project as k.name_project for k in user.domains"
				></select>				
			</div>
			<div class="modal-footer">
				<button 
					type="button"
					class="btn btn-primary pull-right"
					ng-click="changeContext()"
				>	
					<i class="fa fa-cube fa-fw"></i>
					{{'DASHBOARD_CONTEXT_CHANGE' | translate}}
				</button>
			</div>
		</div>
	</div>
</div>
<!--i18n-->
<div id="sensum-i18n-modal" class="modal fade" role="dialog" style="z-index:9000!important">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal">
					<i class="fa fa-times"></i>
				</button>
				<h4 class="modal-title text-uppercase">
					<i class="fa fa-language fa-fw"></i>{{sensum.language}}-{{current_ctrl}}
				</h4>
			</div>
			<div class="modal-body no-padding">
				<div class="input-group">
					<span class="input-group-addon">
						<i class="fa fa-filter"></i>
					</span>
					<input
						class="form-control"
						type="text"
						ng-model="i18nFilter"
					/>					
				</div>
				<table class="table table-bordered table-striped no-margin">
					<thead>
						<tr>
							<th><i class="fa fa-code"></i></th>
							<th><i class="fa fa-globe"></i></th>
							<th><i class="fa fa-flag"></i></th>
							<th><i class="fa fa-flag-o"></i></th>
						</tr>
					</thead>
					<tbody>
						<tr ng-repeat="k in Utils.keys(sensum._backup.modules[current_ctrl].i18n.en) | filter : i18nFilter as i18nFilterResults track by $index">
							<th>
								<small>{{k}}</small>
							</th>
							<td>
								<small>{{sensum._backup.modules[current_ctrl].i18n.en[k]}}</small>
							</th>
							<td>
								<small>{{sensum._backup.modules[current_ctrl].i18n[sensum.language][k]}}</small>
							</td>
							<td class="no-padding" style="width:34%">
								<input
									class="form-control {{sensum._editor.modules[current_ctrl].i18n[sensum.language][k] != sensum._backup.modules[current_ctrl].i18n[sensum.language][k] ? 'bg-green' : ''}}"
									ng-model="sensum._editor.modules[current_ctrl].i18n[sensum.language][k]"
									ng-pattern="/[^'`]/g"
									novalidate
								/>
							</td>
						<tr>
						<tr>
							<td class="no-padding">
								<input
									class="form-control"
									ng-model="new_l10n.key"
									ng-pattern="/[^'`]/g"
									novalidate
								/>
							</td>
							<td>
								{{new_l10n.value}}
							</td>
							<td class="no-padding">
								<input
									class="form-control"
									ng-model="new_l10n.value"
									ng-pattern="/[^'`]/g"
									novalidate
								/>
							</td>
							<td class="no-padding" style="width:34%">
								<button
									type="button"
									class="btn btn-success btn-block"
									ng-click="addL10N()"
								>
									<i class="fa fa-plus"></i>
								</button>
							</td>
						</tr>
					</body>
				</table>
			</div>
			<div class="modal-footer">
				<button
					type="button"
					class="pull-left btn btn-default"
					ng-click="resetL10N()"
				>
					<i class="fa fa-life-saver"></i>
				</button>
				<button
					type="button"
					class="pull-right btn btn-primary"
					ng-click="saveL10N()"
				>
					<i class="fa fa-save"></i>
				</button>
			</div>
		</div>
	</div>
</div>
<!--i18n-->
    </section>
    <!-- /.content -->
  </div>
  <!-- /.content-wrapper -->

  <!-- Main Footer -->
  <footer 
		class="main-footer no-print {{is_mobile ? 'text-center' : '' }}" 
		ng-show="!params.is_frame"
	>
    <!-- Default to the left -->
    <strong>
			Data  &copy; 
			<span ng-show="sensum.project.since">{{sensum.project.since}}-</span>
			{{current_year}} 
			<a href="{{sensum.project.url_company}}" target="_blank">
				{{sensum.project.name_company}}
			</a>.
		</strong>
		<br class="hidden-md hidden-lg"> 
		{{'DASHBOARD_COPYRIGHT' | translate}}
		<br class="hidden-md hidden-lg"> 
    <!-- To the right -->
		<a class="{{is_mobile ? '' : 'pull-right'}} text-bold" target="_blank" href="http://sensum.co.nz">
			<span class="text-black footer-mono">powered by</span>
			<img src="/img/loranexus.svg" height="13px" style="margin-top:-6px;">
		</a>
  </footer>

  <!-- Control Sidebar -->
  <aside ng-show="visible.control_sidebar" class="control-sidebar control-sidebar-dark">
    <!-- Create the tabs -->
    <ul class="nav nav-tabs nav-justified control-sidebar-tabs">
      <li ng-repeat="tabs in control_sidebar_tabs"><a href="#{{tab.id}}" data-toggle="tab"><i class="fa fa-{{tab.icon}}"></i></a></li>
    </ul>
    <!-- Tab panes -->
    <div class="tab-content">
      <!-- Home tab content -->
      <div ng-repeat="tabs in control_sidebar_tabs" class="tab-pane" id="{{tab.id}}">
				<{{tab.component}}></{{tab.component}}>
      </div>
      <!-- /.tab-pane -->
    </div>
  </aside>
  <!-- /.control-sidebar -->
  <!-- Add the sidebar's background. This div must be placed
       immediately after the control sidebar -->
  <div class="control-sidebar-bg"></div>
</div>
<!-- ./wrapper -->
<div 
	class="sensum-login-splash" 
	ng-style="sensum.project.background_image"
	ng-show="!angular_progress || session_timeout"
>
	<div 
		class="sensum-login-overlay" 
	></div>
</div>
<div 
	class="row sensum-login-row"
	ng-show="!angular_progress"
>
	<div class="col-md-4 hidden-xs hidden-sm" ></div>
	<div class="col-md-4 sensum-login-col">
		<div class="box sensum-login-box no-border no-padding" style="background:none;box-shadow:none;">
			<div class="box-header text-center no-border no-padding color-white">
  	    <h1 style="color:white">
