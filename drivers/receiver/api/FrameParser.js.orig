			undefined === schema.frames ||
			schema.frames === null ||
			schema.frames.length === 0
		) {
			return JSON.parse(JSON.stringify(schema.attributes));
		}
		var flen = schema.frames.length;
		var found = false;
		for (var f = 0; f < flen; f++) {
			var schema_frame = schema.frames[f];
